<Window x:Class="FamilyClaimRef.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FamilyClaimRef" Height="620" Width="820"
        Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <TextBlock Text="FamilyClaimRef"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <TextBlock Text="로컬 MVP 확인용 화면입니다. 실제 개인정보, 보험사명, 병원명, 진단명, 진단코드는 사용하지 마세요."
                       TextWrapping="Wrap"
                       Margin="0,0,0,18" />

            <GroupBox Header="Source file" Margin="0,0,0,12">
                <StackPanel Margin="10">
                    <Button Content="Select file"
                            Width="120"
                            HorizontalAlignment="Left"
                            Click="SelectFileButton_Click" />
                    <TextBlock Text="Selected file"
                               FontWeight="SemiBold"
                               Margin="0,10,0,3" />
                    <TextBlock Text="{Binding SelectedSourceFileDisplayName}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Target selection" Margin="0,0,0,12">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Target kind"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8" />
                    <ComboBox Grid.Row="0"
                              Grid.Column="1"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding TargetKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,8">
                        <ComboBoxItem Content="policy" />
                        <ComboBoxItem Content="claim" />
                    </ComboBox>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Policy target"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="policy">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              ItemsSource="{Binding AvailablePolicies}"
                              DisplayMemberPath="DisplayTitle"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedPolicyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,8">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="policy">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Claim target"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="claim">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              ItemsSource="{Binding AvailableClaims}"
                              DisplayMemberPath="DisplayTitle"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedClaimId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,8">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="claim">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="{Binding TargetSelectionMessage}"
                               TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Document metadata" Margin="0,0,0,12">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Document type"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8" />
                    <ComboBox Grid.Row="0"
                              Grid.Column="1"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding DocumentType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,8">
                        <ComboBoxItem Content="policy" />
                        <ComboBoxItem Content="terms" />
                        <ComboBoxItem Content="contract" />
                        <ComboBoxItem Content="capture" />
                        <ComboBoxItem Content="receipt" />
                        <ComboBoxItem Content="diagnosis" />
                        <ComboBoxItem Content="medicine" />
                        <ComboBoxItem Content="visit" />
                        <ComboBoxItem Content="admission" />
                        <ComboBoxItem Content="surgery" />
                        <ComboBoxItem Content="etc" />
                    </ComboBox>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Display title"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding DisplayTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Reference date"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <DatePicker Grid.Row="2"
                                Grid.Column="1"
                                SelectedDate="{Binding ReferenceDate, Mode=TwoWay}" />
                </Grid>
            </GroupBox>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Register"
                        Width="120"
                        Click="RegisterButton_Click" />
                <TextBlock Text="{Binding IsBusy, StringFormat=Is busy: {0}}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0" />
            </StackPanel>

            <GroupBox Header="Status">
                <StackPanel Margin="10">
                    <TextBlock Text="Validation"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ValidationMessage}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,8" />
                    <TextBlock Text="Status"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,8" />
                    <TextBlock Text="Last registration summary"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LastRegistrationSummary}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
