<Window x:Class="FamilyClaimRef.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{StaticResource Ui.App.Title}" Height="760" Width="900"
        Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <TextBlock Text="{StaticResource Ui.App.Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <TextBlock Text="{StaticResource Ui.DevHarness.Warning.LocalMvpValidation}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18" />

            <StackPanel DataContext="{Binding DocumentRegistration}">
                <GroupBox Header="{StaticResource Ui.Document.SourceFileSection}" Margin="0,0,0,12">
                    <StackPanel Margin="10">
                        <Button Content="{StaticResource Ui.Action.SelectFile}"
                                Width="120"
                                HorizontalAlignment="Left"
                                Click="SelectFileButton_Click" />
                        <TextBlock Text="{StaticResource Ui.Document.SelectedFileLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,3" />
                        <TextBlock Text="{Binding SelectedSourceFileDisplayName}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{StaticResource Ui.Target.SelectionSection}" Margin="0,0,0,12">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{StaticResource Ui.Target.KindLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8" />
                        <ComboBox Grid.Row="0"
                                  Grid.Column="1"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding TargetKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,8">
                            <ComboBoxItem Content="policy" />
                            <ComboBoxItem Content="claim" />
                        </ComboBox>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{StaticResource Ui.Policy.TargetLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TargetKind}" Value="policy">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  ItemsSource="{Binding AvailablePolicies}"
                                  DisplayMemberPath="DisplayTitle"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedPolicyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,8">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TargetKind}" Value="policy">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="{StaticResource Ui.Claim.TargetLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TargetKind}" Value="claim">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox Grid.Row="2"
                                  Grid.Column="1"
                                  ItemsSource="{Binding AvailableClaims}"
                                  DisplayMemberPath="DisplayTitle"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedClaimId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,8">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TargetKind}" Value="claim">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding TargetSelectionMessage}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="{StaticResource Ui.Document.MetadataSection}" Margin="0,0,0,12">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{StaticResource Ui.Document.TypeLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8" />
                        <ComboBox Grid.Row="0"
                                  Grid.Column="1"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding DocumentType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,8">
                            <ComboBoxItem Content="policy" />
                            <ComboBoxItem Content="terms" />
                            <ComboBoxItem Content="contract" />
                            <ComboBoxItem Content="capture" />
                            <ComboBoxItem Content="receipt" />
                            <ComboBoxItem Content="diagnosis" />
                            <ComboBoxItem Content="medicine" />
                            <ComboBoxItem Content="visit" />
                            <ComboBoxItem Content="admission" />
                            <ComboBoxItem Content="surgery" />
                            <ComboBoxItem Content="etc" />
                        </ComboBox>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{StaticResource Ui.Document.DisplayTitleLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding DisplayTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="{StaticResource Ui.Document.ReferenceDateLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <DatePicker Grid.Row="2"
                                    Grid.Column="1"
                                    SelectedDate="{Binding ReferenceDate, Mode=TwoWay}" />
                    </Grid>
                </GroupBox>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="{StaticResource Ui.Action.RegisterDocument}"
                            Width="120"
                            Click="RegisterButton_Click" />
                    <TextBlock Text="{Binding IsBusy, StringFormat=Is busy: {0}}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                </StackPanel>

                <GroupBox Header="{StaticResource Ui.Status.RegistrationSection}" Margin="0,0,0,12">
                    <StackPanel Margin="10">
                        <TextBlock Text="{StaticResource Ui.Validation.SectionLabel}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ValidationMessage}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,8" />
                        <TextBlock Text="{StaticResource Ui.Status.Label}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,8" />
                        <TextBlock Text="{StaticResource Ui.Status.LastRegistrationSummaryLabel}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastRegistrationSummary}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <GroupBox Header="{StaticResource Ui.Management.PolicyClaimSection}"
                      DataContext="{Binding PolicyClaimManagement}">
                <StackPanel Margin="10">
                    <TextBlock Text="{StaticResource Ui.DevHarness.ManagementWarning}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0"
                                  Header="{StaticResource Ui.Management.PolicySection}"
                                  Margin="0,0,8,0">
                            <StackPanel Margin="10">
                                <TextBlock Text="{StaticResource Ui.Policy.ActiveTargetsLabel}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />
                                <ListBox ItemsSource="{Binding AvailablePolicies}"
                                         DisplayMemberPath="DisplayTitle"
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding SelectedPolicyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="96"
                                         Margin="0,0,0,8" />
                                <TextBlock Text="{StaticResource Ui.Policy.NewTitleLabel}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewPolicyDisplayTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{StaticResource Ui.Action.CreatePolicy}"
                                            Width="110"
                                            IsEnabled="{Binding CanCreatePolicy}"
                                            Click="CreatePolicyButton_Click" />
                                    <Button Content="{StaticResource Ui.Action.DisablePolicy}"
                                            Width="110"
                                            Margin="8,0,0,0"
                                            IsEnabled="{Binding CanDisablePolicy}"
                                            Click="DisablePolicyButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="1"
                                  Header="{StaticResource Ui.Management.ClaimSection}"
                                  Margin="8,0,0,0">
                            <StackPanel Margin="10">
                                <TextBlock Text="{StaticResource Ui.Claim.PolicyForNewClaimLabel}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailablePolicies}"
                                          DisplayMemberPath="DisplayTitle"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedPolicyForClaimId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,8" />
                                <TextBlock Text="{StaticResource Ui.Claim.ActiveTargetsLabel}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />
                                <ListBox ItemsSource="{Binding AvailableClaims}"
                                         DisplayMemberPath="DisplayTitle"
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding SelectedClaimId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="96"
                                         Margin="0,0,0,8" />
                                <TextBlock Text="{StaticResource Ui.Claim.NewTitleLabel}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewClaimDisplayTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{StaticResource Ui.Action.CreateClaim}"
                                            Width="110"
                                            IsEnabled="{Binding CanCreateClaim}"
                                            Click="CreateClaimButton_Click" />
                                    <Button Content="{StaticResource Ui.Action.DisableClaim}"
                                            Width="110"
                                            Margin="8,0,0,0"
                                            IsEnabled="{Binding CanDisableClaim}"
                                            Click="DisableClaimButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </Grid>

                    <TextBlock Text="{StaticResource Ui.Management.MessageLabel}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ManagementMessage}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
