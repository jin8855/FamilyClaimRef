<Window x:Class="FamilyClaimRef.App.ProductShell.ProductShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FamilyClaimRef.App.Views"
        xmlns:viewModels="clr-namespace:FamilyClaimRef.App.ViewModels"
        Title="{Binding ShellTitle}"
        Width="1280"
        Height="840"
        MinWidth="960"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ProductWindowStyle}">
    <Window.Resources>
        <DataTemplate x:Key="HomeContentTemplate">
            <views:ProductHomeView
                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="PolicyContractsContentTemplate">
            <views:ProductPolicyContractsView
                DataContext="{Binding DataContext.PolicyClaimManagement, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="ClaimCasesContentTemplate">
            <views:ProductClaimCasesView
                DataContext="{Binding DataContext.PolicyClaimManagement, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="ClaimSubmissionContentTemplate">
            <views:ProductClaimSubmissionView
                DataContext="{Binding DataContext.ClaimSubmissionManagement, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="ClaimCompleteContentTemplate">
            <views:ProductClaimCompleteSummaryView
                DataContext="{Binding DataContext.ClaimCompleteSummary, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="ClaimHistoryListContentTemplate">
            <views:ProductClaimHistoryListView
                DataContext="{Binding DataContext.ClaimHistory, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="ClaimHistoryDetailContentTemplate">
            <views:ProductClaimHistoryDetailView
                DataContext="{Binding DataContext.ClaimHistory, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>
        <DataTemplate x:Key="DocumentRegistrationContentTemplate">
            <views:ProductDocumentRegistrationView
                DataContext="{Binding DataContext.DocumentRegistration, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="DocumentListContentTemplate">
            <views:ProductDocumentListView
                DataContext="{Binding DataContext.DocumentList, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="FamilyMembersContentTemplate">
            <views:ProductFamilyMembersView
                DataContext="{Binding DataContext.FamilyMemberManagement, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="FamilyMemberEditorContentTemplate">
            <views:ProductFamilyMemberEditorView
                DataContext="{Binding DataContext.FamilyMemberManagement, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="InsurancePolicyEditorContentTemplate">
            <views:ProductInsurancePolicyEditorView
                DataContext="{Binding DataContext.PolicyClaimManagement, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="CategoryManagementContentTemplate">
            <views:ProductCategoryManagementView
                DataContext="{Binding DataContext.CategoryManagement, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="CategoryEditorContentTemplate">
            <views:ProductCategoryEditorView
                DataContext="{Binding DataContext.CategoryManagement, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="CategoryItemEditorContentTemplate">
            <views:ProductCategoryItemEditorView
                DataContext="{Binding DataContext.CategoryManagement, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
        </DataTemplate>

        <DataTemplate x:Key="WireframeContentTemplate">
            <views:ProductWireframeScreenView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource ProductSurfaceBrush}"
                BorderBrush="{StaticResource ProductBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center"
                            Margin="0,0,30,0">
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Common.Brand}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Common.BrandSubtitle}"
                               Style="{StaticResource ProductSubtitleStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="{StaticResource Ui.Product.Wireframe.01_home_dashboard.Title}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.HomeDashboard}"
                            AutomationProperties.AutomationId="ProductNav_Home"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.07_claim_case.Title}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimCase}"
                            AutomationProperties.AutomationId="ProductNav_Claim"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.03_policy_list.Title}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.PolicyList}"
                            AutomationProperties.AutomationId="ProductNav_Policy"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.10_history_view.Title}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.HistoryView}"
                            AutomationProperties.AutomationId="ProductNav_History"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.15_manage_home.Title}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.ManageHome}"
                            AutomationProperties.AutomationId="ProductNav_Manage"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                </StackPanel>

            </Grid>
        </Border>

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentScreen}">
            <ContentControl.Style>
                <Style TargetType="{x:Type ContentControl}">
                    <Setter Property="ContentTemplate"
                            Value="{StaticResource WireframeContentTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="01_home_dashboard">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource HomeContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="11_policy_manage">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource PolicyContractsContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="07_claim_case">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource ClaimCasesContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="08_claim_submission">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource ClaimSubmissionContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="14_claim_complete">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource ClaimCompleteContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="10_history_view">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource ClaimHistoryListContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="21_history_detail">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource ClaimHistoryDetailContentTemplate}" />
                        </DataTrigger>                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="17_policy_document_register">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource DocumentRegistrationContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="18_claim_document_register">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource DocumentRegistrationContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="05_document_box">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource DocumentListContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="02_family_members">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource FamilyMembersContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="13_family_register">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource FamilyMemberEditorContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="12_policy_register">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource InsurancePolicyEditorContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="16_category_manage">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource CategoryManagementContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="19_category_register">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource CategoryEditorContentTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Id, RelativeSource={RelativeSource Self}}"
                                     Value="20_category_item_register">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource CategoryItemEditorContentTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</Window>
