<UserControl x:Class="FamilyClaimRef.App.Views.ProductCategoryEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FamilyClaimRef.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="ProductScreen_19">
        <Grid MaxWidth="1100"
              Margin="28,24,28,36"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Breadcrumb, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductPageTitleStyle}" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Subtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.SaveAction}"
                            Click="SaveButton_Click"
                            IsEnabled="{Binding CanSaveCategory}"
                            AutomationProperties.AutomationId="ProductCategoryEditor_Save"
                            Style="{StaticResource ProductPrimaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.DeleteAction}"
                            IsEnabled="False"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.CloseAction}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.CategoryManage}"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource ProductPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{StaticResource Ui.Product.Category.NameLabel}" />
                        <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProductCategoryEditor_Name" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{StaticResource Ui.Product.Category.CodeLabel}" />
                        <TextBox Text="{Binding CategoryCode, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProductCategoryEditor_Code" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Margin="0,14,0,0">
                        <TextBlock Text="{StaticResource Ui.Product.Category.SortOrderLabel}" />
                        <TextBox Text="{Binding CategorySortOrderText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProductCategoryEditor_SortOrder" />
                    </StackPanel>
                    <CheckBox Grid.Row="1"
                              Grid.Column="2"
                              Margin="0,32,0,0"
                              Content="{StaticResource Ui.Product.Category.SystemDefaultLabel}"
                              IsChecked="{Binding CategoryIsSystemDefault}"
                              AutomationProperties.AutomationId="ProductCategoryEditor_SystemDefault" />
                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="3"
                                Margin="0,14,0,0">
                        <TextBlock Text="{StaticResource Ui.Product.Category.DescriptionLabel}" />
                        <TextBox Text="{Binding CategoryDescription, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="96"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="ProductCategoryEditor_Description" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,14,0,0"
                    Style="{StaticResource ProductPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Management.StatusLabel}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ManagementMessage}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ProductCategoryEditor_Status" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
