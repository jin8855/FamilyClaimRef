<UserControl x:Class="FamilyClaimRef.App.Views.ProductCategoryItemEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FamilyClaimRef.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="ProductScreen_20">
        <Grid MaxWidth="1100"
              Margin="28,24,28,36"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Breadcrumb, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductPageTitleStyle}" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Subtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.SaveAction}"
                            Click="SaveButton_Click"
                            IsEnabled="{Binding CanSaveItem}"
                            AutomationProperties.AutomationId="ProductCategoryItemEditor_Save"
                            Style="{StaticResource ProductPrimaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.DeleteAction}"
                            IsEnabled="False"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.CloseAction}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.CategoryManage}"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource ProductPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.ColumnSpan="3">
                        <TextBlock Text="{StaticResource Ui.Product.Category.ParentLabel}" />
                        <ComboBox ItemsSource="{Binding ActiveParentCategories}"
                                  SelectedItem="{Binding SelectedItemParentCategory}"
                                  DisplayMemberPath="Name"
                                  IsEnabled="{Binding CanSelectItemParent}"
                                  AutomationProperties.AutomationId="ProductCategoryItemEditor_Parent" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Margin="0,14,0,0">
                        <TextBlock Text="{StaticResource Ui.Product.Category.ItemNameLabel}" />
                        <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProductCategoryItemEditor_Name" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,14,0,0">
                        <TextBlock Text="{StaticResource Ui.Product.Category.CodeLabel}" />
                        <TextBox Text="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProductCategoryItemEditor_Code" />
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Margin="0,14,0,0">
                        <TextBlock Text="{StaticResource Ui.Product.Category.SortOrderLabel}" />
                        <TextBox Text="{Binding ItemSortOrderText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProductCategoryItemEditor_SortOrder" />
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Grid.Column="2"
                                Margin="0,30,0,0"
                                Orientation="Horizontal">
                        <CheckBox Content="{StaticResource Ui.Product.Category.PolicySearchLabel}"
                                  IsChecked="{Binding ItemUseForPolicySearch}"
                                  Margin="0,0,18,0" />
                        <CheckBox Content="{StaticResource Ui.Product.Category.HistorySearchLabel}"
                                  IsChecked="{Binding ItemUseForHistorySearch}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3"
                                Grid.ColumnSpan="3"
                                Margin="0,14,0,0">
                        <TextBlock Text="{StaticResource Ui.Product.Category.DescriptionLabel}" />
                        <TextBox Text="{Binding ItemDescription, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="96"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="ProductCategoryItemEditor_Description" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,14,0,0"
                    Style="{StaticResource ProductPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Management.StatusLabel}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ManagementMessage}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ProductCategoryItemEditor_Status" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
