<UserControl x:Class="FamilyClaimRef.App.Views.ProductCategoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FamilyClaimRef.App.ViewModels"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="ProductScreen_16">
        <Grid MaxWidth="1420"
              Margin="28,24,28,36"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Breadcrumb, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductPageTitleStyle}" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Subtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="{StaticResource Ui.Product.Category.RegisterCategoryAction}"
                            Click="RegisterCategoryButton_Click"
                            IsEnabled="{Binding CanUseRowActions}"
                            AutomationProperties.AutomationId="ProductCategory_RegisterCategory"
                            Style="{StaticResource ProductPrimaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Category.RegisterItemAction}"
                            Click="RegisterItemButton_Click"
                            IsEnabled="{Binding CanCreateItem}"
                            AutomationProperties.AutomationId="ProductCategory_RegisterItem"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.15_manage_home.Title}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.ManageHome}"
                            AutomationProperties.AutomationId="ProductCategory_ManageHome"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="#FBFCFD"
                    Padding="12"
                    Margin="0,0,0,14">
                <TextBlock Text="{StaticResource Ui.Product.Category.Guidance}"
                           Style="{StaticResource ProductSubtitleStyle}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ProductPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{StaticResource Ui.Product.Category.CategoryListTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,12" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MinHeight="340"
                                  AutomationProperties.AutomationId="ProductCategory_CategoryList">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{StaticResource Ui.Product.Category.NameLabel}"
                                                    Binding="{Binding Name}"
                                                    Width="2*" />
                                <DataGridTextColumn Header="{StaticResource Ui.Product.Category.CodeLabel}"
                                                    Binding="{Binding Code}"
                                                    Width="*" />
                                <DataGridTextColumn Header="{StaticResource Ui.Product.Category.ItemCountLabel}"
                                                    Binding="{Binding Items.Count}"
                                                    Width="70" />
                                <DataGridTemplateColumn Header="{StaticResource Ui.Product.Category.StateLabel}"
                                                        Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Text" Value="{StaticResource Ui.Product.Category.InactiveValue}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="{StaticResource Ui.Product.Category.ActiveValue}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{StaticResource Ui.Product.Category.ActionsLabel}"
                                                        Width="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{StaticResource Ui.Product.Wireframe.Common.EditAction}"
                                                        Click="EditCategoryButton_Click"
                                                        IsEnabled="{Binding DataContext.CanUseRowActions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        Style="{StaticResource ProductSecondaryButtonStyle}" />
                                                <Button Click="DeactivateCategoryButton_Click">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}"
                                                               BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                                            <Setter Property="Content" Value="{StaticResource Ui.Product.Wireframe.Common.DisableAction}" />
                                                            <Setter Property="IsEnabled" Value="{Binding DataContext.CanUseRowActions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{StaticResource Ui.Product.Category.ReactivateAction}"
                                                        Click="ReactivateCategoryButton_Click"
                                                        IsEnabled="{Binding DataContext.CanUseRowActions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}"
                                                               BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource ProductPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{StaticResource Ui.Product.Category.ItemListTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,12" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding SelectedCategoryItems}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MinHeight="340"
                                  AutomationProperties.AutomationId="ProductCategory_ItemList">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{StaticResource Ui.Product.Category.ItemNameLabel}"
                                                    Binding="{Binding Name}"
                                                    Width="2*" />
                                <DataGridTextColumn Header="{StaticResource Ui.Product.Category.CodeLabel}"
                                                    Binding="{Binding Code}"
                                                    Width="*" />
                                <DataGridTemplateColumn Header="{StaticResource Ui.Product.Category.StateLabel}"
                                                        Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Text" Value="{StaticResource Ui.Product.Category.InactiveValue}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="{StaticResource Ui.Product.Category.ActiveValue}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{StaticResource Ui.Product.Category.ActionsLabel}"
                                                        Width="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{StaticResource Ui.Product.Wireframe.Common.EditAction}"
                                                        Click="EditItemButton_Click"
                                                        IsEnabled="{Binding DataContext.CanUseRowActions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        Style="{StaticResource ProductSecondaryButtonStyle}" />
                                                <Button Click="DeactivateItemButton_Click">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}"
                                                               BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                                            <Setter Property="Content" Value="{StaticResource Ui.Product.Wireframe.Common.DisableAction}" />
                                                            <Setter Property="IsEnabled" Value="{Binding DataContext.CanUseRowActions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{StaticResource Ui.Product.Category.ReactivateAction}"
                                                        Click="ReactivateItemButton_Click"
                                                        IsEnabled="{Binding DataContext.CanUseRowActions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}"
                                                               BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Margin="0,14,0,0"
                    Style="{StaticResource ProductPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Management.StatusLabel}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ManagementMessage}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ProductCategory_Status" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
