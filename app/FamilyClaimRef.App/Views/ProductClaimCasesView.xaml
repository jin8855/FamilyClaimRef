<UserControl x:Class="FamilyClaimRef.App.Views.ProductClaimCasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FamilyClaimRef.App.ViewModels"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="ProductScreen_07">
        <Grid MaxWidth="1520"
              Margin="24,20,24,36"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{Binding DataContext.CurrentScreen.Breadcrumb, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Style="{StaticResource ProductSubtitleStyle}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding DataContext.CurrentScreen.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Style="{StaticResource ProductPageTitleStyle}" />
                <TextBlock Text="{Binding DataContext.CurrentScreen.Subtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Style="{StaticResource ProductSubtitleStyle}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <UniformGrid Grid.Row="1"
                         Columns="5"
                         Margin="0,0,0,14">
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step1}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimCase}"
                        AutomationProperties.AutomationId="ProductClaim_Step1"
                        Style="{StaticResource ProductPrimaryButtonStyle}" />
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step2}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.OcrReview}"
                        AutomationProperties.AutomationId="ProductClaim_Step2"
                        Style="{StaticResource ProductSecondaryButtonStyle}" />
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step3}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimReferenceResult}"
                        AutomationProperties.AutomationId="ProductClaim_Step3"
                        Style="{StaticResource ProductSecondaryButtonStyle}" />
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step4}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimSubmission}"
                        AutomationProperties.AutomationId="ProductClaim_Step4"
                        Style="{StaticResource ProductSecondaryButtonStyle}" />
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step5}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimComplete}"
                        AutomationProperties.AutomationId="ProductClaim_Step5"
                        Style="{StaticResource ProductSecondaryButtonStyle}" />
            </UniformGrid>

            <Border Grid.Row="2"
                    Style="{StaticResource ProductPanelStyle}"
                    AutomationProperties.AutomationId="ProductClaimFlow_Context">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextTitle}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,10" />
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextPolicyLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding DataContext.ClaimContextPolicyDisplayTitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextClaimLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding DataContext.ClaimContextClaimDisplayTitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextInputLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding DataContext.ClaimContextInputState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextConfirmationLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding DataContext.ClaimContextConfirmationState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ProductPanelStyle}"
                        Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.DocumentsTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,10" />
                        <Button Content="{StaticResource Ui.Product.Wireframe.18_claim_document_register.Title}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimDocumentRegister}"
                                AutomationProperties.AutomationId="ProductClaim_AddDocument"
                                Style="{StaticResource ProductPrimaryButtonStyle}" />
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.DocumentBox.ClaimTypes}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="0,0,14,0">
                    <Border Style="{StaticResource ProductPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.InputTitle}"
                                       Style="{StaticResource ProductSectionTitleStyle}"
                                       Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding DataContext.CurrentScreen.Fields, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="230"
                                                    Margin="0,0,12,10">
                                            <TextBlock Text="{Binding Label}"
                                                       Style="{StaticResource ProductSubtitleStyle}"
                                                       Margin="0,0,0,4" />
                                            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding Label}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Common.PresentationOnlyMessage}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ProductPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ManagementTitle}"
                                       Style="{StaticResource ProductSectionTitleStyle}"
                                       Margin="0,0,0,10" />
                            <TextBlock Text="{StaticResource Ui.Product.ClaimCases.PolicyLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}"
                                       Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailablePolicies}"
                                      DisplayMemberPath="DisplayTitle"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedPolicyForClaimId, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="ProductClaim_Policy"
                                      Margin="0,0,0,10" />
                            <TextBlock Text="{StaticResource Ui.Product.ClaimCases.DisplayTitleLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}"
                                       Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewClaimDisplayTitle, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ProductClaim_DisplayTitle"
                                         Margin="0,0,10,0" />
                                <Button Grid.Column="1"
                                        Content="{StaticResource Ui.Product.ClaimCases.CreateAction}"
                                        IsEnabled="{Binding CanCreateClaim}"
                                        Click="CreateButton_Click"
                                        AutomationProperties.AutomationId="ProductClaim_Create"
                                        Style="{StaticResource ProductPrimaryButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ProductPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Ui.Product.ClaimCases.ActiveListLabel}"
                                       Style="{StaticResource ProductSectionTitleStyle}"
                                       Margin="0,0,0,10" />
                            <ListBox ItemsSource="{Binding AvailableClaims}"
                                     DisplayMemberPath="DisplayTitle"
                                     SelectedValuePath="Id"
                                     SelectedValue="{Binding SelectedClaimId, Mode=TwoWay}"
                                     MinHeight="90"
                                     AutomationProperties.AutomationId="ProductClaim_List" />
                            <TextBlock Text="{StaticResource Ui.Product.ClaimCases.EmptyMessage}"
                                       Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource ProductSubtitleStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvailableClaims}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="{StaticResource Ui.Product.ClaimCases.DisableAction}"
                                    IsEnabled="{Binding CanDisableClaim}"
                                    Click="DisableButton_Click"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="ProductClaim_Disable"
                                    Style="{StaticResource ProductSecondaryButtonStyle}"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2"
                        Style="{StaticResource ProductPanelStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.GuideTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.GuideOne}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.GuideTwo}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.GuideThree}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Style="{StaticResource ProductPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Management.StatusLabel}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ManagementMessage}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ProductClaim_Status" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
