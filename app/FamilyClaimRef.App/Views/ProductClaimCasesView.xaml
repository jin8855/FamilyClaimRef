<UserControl x:Class="FamilyClaimRef.App.Views.ProductClaimCasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FamilyClaimRef.App.ViewModels"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="ProductScreen_07">
        <Grid MaxWidth="1520"
              Margin="24,20,24,36"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{Binding DataContext.CurrentScreen.Breadcrumb, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Style="{StaticResource ProductSubtitleStyle}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding DataContext.CurrentScreen.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Style="{StaticResource ProductPageTitleStyle}" />
                <TextBlock Text="{Binding DataContext.CurrentScreen.Subtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Style="{StaticResource ProductSubtitleStyle}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <UniformGrid Grid.Row="1"
                         Columns="5"
                         Margin="0,0,0,14">
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step1}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimCase}"
                        AutomationProperties.AutomationId="ProductClaim_Step1"
                        Style="{StaticResource ProductPrimaryButtonStyle}" />
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step2}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.OcrReview}"
                        AutomationProperties.AutomationId="ProductClaim_Step2"
                        Style="{StaticResource ProductSecondaryButtonStyle}" />
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step3}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimReferenceResult}"
                        AutomationProperties.AutomationId="ProductClaim_Step3"
                        Style="{StaticResource ProductSecondaryButtonStyle}" />
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step4}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimSubmission}"
                        AutomationProperties.AutomationId="ProductClaim_Step4"
                        Style="{StaticResource ProductSecondaryButtonStyle}" />
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step5}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimComplete}"
                        AutomationProperties.AutomationId="ProductClaim_Step5"
                        Style="{StaticResource ProductSecondaryButtonStyle}" />
            </UniformGrid>

            <Border Grid.Row="2"
                    Style="{StaticResource ProductPanelStyle}"
                    AutomationProperties.AutomationId="ProductClaimFlow_Context">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextTitle}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,10" />
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextPolicyLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding DataContext.ClaimContextPolicyDisplayTitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextClaimLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding DataContext.ClaimContextClaimDisplayTitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextInputLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding DataContext.ClaimContextInputState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextConfirmationLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding DataContext.ClaimContextConfirmationState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ProductPanelStyle}"
                        Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.DocumentsTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,10" />
                        <Button Content="{StaticResource Ui.Product.Wireframe.18_claim_document_register.Title}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimDocumentRegister}"
                                AutomationProperties.AutomationId="ProductClaim_AddDocument"
                                Style="{StaticResource ProductPrimaryButtonStyle}" />
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.DocumentBox.ClaimTypes}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="0,0,14,0">
                    <Border Style="{StaticResource ProductPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Ui.Product.ClaimCases.EditorTitle}"
                                       Style="{StaticResource ProductSectionTitleStyle}"
                                       Margin="0,0,0,10" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimCases.FamilyLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableClaimFamilyMembers}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedClaimFamilyMemberId, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="ProductClaim_Family" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimCases.DisplayTitleLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ClaimCaseDisplayTitle, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="ProductClaim_DisplayTitle" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimCases.TreatmentDateLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding ClaimTreatmentDate, Mode=TwoWay}"
                                                AutomationProperties.AutomationId="ProductClaim_TreatmentDate" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimCases.HospitalNameLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ClaimHospitalName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="ProductClaim_HospitalName" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimCases.DiagnosisCodeLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ClaimDiagnosisCode, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="ProductClaim_DiagnosisCode" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimCases.DiagnosisNameLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ClaimDiagnosisName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="ProductClaim_DiagnosisName" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimCases.VisitTypeLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ClaimCaseVisitTypeOptions}"
                                              DisplayMemberPath="DisplayText"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding ClaimVisitType, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="ProductClaim_VisitType" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,18,0,10">
                                    <CheckBox Content="{StaticResource Ui.Product.ClaimCases.HasSurgeryLabel}"
                                              IsChecked="{Binding ClaimHasSurgery}"
                                              AutomationProperties.AutomationId="ProductClaim_HasSurgery"
                                              Margin="0,0,16,0" />
                                    <CheckBox Content="{StaticResource Ui.Product.ClaimCases.HasPrescriptionLabel}"
                                              IsChecked="{Binding ClaimHasPrescription}"
                                              AutomationProperties.AutomationId="ProductClaim_HasPrescription" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimCases.CoveredAmountLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ClaimCoveredAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             TextAlignment="Right"
                                             AutomationProperties.AutomationId="ProductClaim_CoveredAmount" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimCases.NonCoveredAmountLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ClaimNonCoveredAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             TextAlignment="Right"
                                             AutomationProperties.AutomationId="ProductClaim_NonCoveredAmount" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimCases.PrescriptionAmountLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ClaimPrescriptionAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             TextAlignment="Right"
                                             AutomationProperties.AutomationId="ProductClaim_PrescriptionAmount" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{StaticResource Ui.Product.ClaimCases.MemoLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding ClaimMemo, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     MinHeight="64"
                                     AutomationProperties.AutomationId="ProductClaim_Memo" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ProductPanelStyle}">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="{StaticResource Ui.Product.ClaimCases.NewAction}"
                                    Click="NewButton_Click"
                                    AutomationProperties.AutomationId="ProductClaim_New"
                                    Style="{StaticResource ProductSecondaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="{StaticResource Ui.Product.ClaimCases.CreateDraftAction}"
                                    IsEnabled="{Binding CanCreateClaimCase}"
                                    Click="CreateButton_Click"
                                    AutomationProperties.AutomationId="ProductClaim_Create"
                                    Style="{StaticResource ProductPrimaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="{StaticResource Ui.Product.ClaimCases.SaveAction}"
                                    IsEnabled="{Binding CanSaveClaimCase}"
                                    Click="SaveButton_Click"
                                    AutomationProperties.AutomationId="ProductClaim_Save"
                                    Style="{StaticResource ProductPrimaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="{StaticResource Ui.Product.ClaimCases.DisableAction}"
                                    IsEnabled="{Binding CanDisableClaimCase}"
                                    Click="DisableButton_Click"
                                    AutomationProperties.AutomationId="ProductClaim_Disable"
                                    Style="{StaticResource ProductSecondaryButtonStyle}" />
                        </WrapPanel>
                    </Border>

                    <Border Style="{StaticResource ProductPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Ui.Product.ClaimCases.ActiveListLabel}"
                                       Style="{StaticResource ProductSectionTitleStyle}"
                                       Margin="0,0,0,10" />
                            <ListBox ItemsSource="{Binding AvailableClaims}"
                                     DisplayMemberPath="DisplayTitle"
                                     SelectedValuePath="Id"
                                     SelectedValue="{Binding SelectedClaimId, Mode=TwoWay}"
                                     SelectionChanged="ClaimList_SelectionChanged"
                                     MinHeight="90"
                                     AutomationProperties.AutomationId="ProductClaim_List" />
                            <TextBlock Text="{StaticResource Ui.Product.ClaimCases.EmptyMessage}"
                                       Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource ProductSubtitleStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvailableClaims}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="{StaticResource Ui.Product.ClaimCases.OpenDocumentsAction}"
                                    IsEnabled="{Binding CanDisableClaimCase}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimDocumentRegister}"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="ProductClaim_OpenDocuments"
                                    Style="{StaticResource ProductSecondaryButtonStyle}"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2"
                        Style="{StaticResource ProductPanelStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.GuideTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.GuideOne}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.GuideTwo}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.GuideThree}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Style="{StaticResource ProductPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Management.StatusLabel}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ClaimCaseValidationMessage}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ProductClaim_ValidationStatus" />
                    <TextBlock Text="{Binding ClaimCaseConflictMessage}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ProductClaim_ConflictStatus" />
                    <TextBlock Text="{Binding ClaimCaseLegacyReviewMessage}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ProductClaim_LegacyStatus" />
                    <TextBlock Text="{Binding ClaimCaseOperationMessage}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ProductClaim_Status" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
