<UserControl x:Class="FamilyClaimRef.App.Views.ProductClaimCompleteSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FamilyClaimRef.App.ViewModels"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.AutomationId="ProductScreen_14">
        <Grid MaxWidth="1520"
              Margin="24,20,24,36"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Breadcrumb, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductPageTitleStyle}" />
                    <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.Guidance}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top">
                    <Button Content="{StaticResource Ui.Product.ClaimComplete.BackToSubmissionAction}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimSubmission}"
                            AutomationProperties.AutomationId="ProductClaimComplete_BackToSubmission"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.ClaimSubmission.HistoryAction}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.HistoryView}"
                            AutomationProperties.AutomationId="ProductClaimComplete_GoHistory"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                </WrapPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,18,0,14"
                    AutomationProperties.AutomationId="ProductClaimComplete_StateMessage">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource ProductPanelStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStateMessage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StateMessage}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource ProductWarningBrush}" />
            </Border>

            <StackPanel Grid.Row="2"
                        AutomationProperties.AutomationId="ProductClaimComplete_Summary">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSummary}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Style="{StaticResource ProductPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.ClaimInfoSectionTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,12" />
                        <UniformGrid Grid.Row="1" Columns="4">
                            <StackPanel Margin="0,0,14,10">
                                <TextBlock Text="{StaticResource Ui.Product.Wireframe.07_claim_case.Title}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                                <TextBlock Text="{Binding ClaimDisplayTitle}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,10">
                                <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.FamilyLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                                <TextBlock Text="{Binding FamilyDisplayName}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,10">
                                <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.TreatmentDateLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                                <TextBlock Text="{Binding TreatmentDateDisplay}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,10">
                                <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.HospitalLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                                <TextBlock Text="{Binding HospitalName}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.DiagnosisLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                                <TextBlock Text="{Binding DiagnosisDisplay}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.VisitTypeLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                                <TextBlock Text="{Binding VisitTypeDisplay}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.CaseStatusLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                                <TextBlock Text="{Binding CaseStatusDisplay}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ProductPanelStyle}"
                            Margin="0,0,14,14">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.SubmissionCountsSectionTitle}"
                                       Style="{StaticResource ProductSectionTitleStyle}"
                                       Margin="0,0,0,12" />
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.SubmissionTotalLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}" />
                                    <TextBlock Text="{Binding SubmissionTotalCount}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.SubmissionInProgressLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}" />
                                    <TextBlock Text="{Binding SubmissionInProgressCount}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.SubmissionCompletedLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}" />
                                    <TextBlock Text="{Binding SubmissionCompletedCount}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.SubmissionCancelledLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}" />
                                    <TextBlock Text="{Binding SubmissionCancelledCount}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource ProductPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.PaymentCountsSectionTitle}"
                                       Style="{StaticResource ProductSectionTitleStyle}"
                                       Margin="0,0,0,12" />
                            <UniformGrid Columns="5">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.PaymentPendingLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}" />
                                    <TextBlock Text="{Binding PaymentPendingCount}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.PaymentPaidLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}" />
                                    <TextBlock Text="{Binding PaymentPaidCount}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.PaymentPartiallyPaidLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}" />
                                    <TextBlock Text="{Binding PaymentPartiallyPaidCount}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.PaymentDeniedLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}" />
                                    <TextBlock Text="{Binding PaymentDeniedCount}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.PaymentCancelledLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}" />
                                    <TextBlock Text="{Binding PaymentCancelledCount}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource ProductPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{StaticResource Ui.Product.ClaimComplete.SubmissionListTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,12" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Submissions}"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  MaxHeight="420"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.AutomationId="ProductClaimComplete_SubmissionList">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid"
                                       BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSubmissions}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="AutomationProperties.Name"
                                            Value="{Binding PolicyDisplayTitle}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{StaticResource Ui.Product.ClaimComplete.PolicyLabel}"
                                                    Binding="{Binding PolicyDisplayTitle}"
                                                    Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding PolicyDisplayTitle}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{StaticResource Ui.Product.ClaimComplete.SubmissionStatusLabel}"
                                                    Binding="{Binding SubmissionStatusDisplay}"
                                                    Width="125" />
                                <DataGridTextColumn Header="{StaticResource Ui.Product.ClaimComplete.PaymentSummaryLabel}"
                                                    Binding="{Binding PaymentSummaryDisplay}"
                                                    Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding PaymentSummaryDisplay}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{StaticResource Ui.Product.ClaimComplete.UpdatedAtLabel}"
                                                    Binding="{Binding UpdatedAtDisplay}"
                                                    Width="135" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1"
                                   Text="{StaticResource Ui.Product.ClaimComplete.SubmissionEmptyMessage}"
                                   TextWrapping="Wrap"
                                   Margin="8,12,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSubmissions}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
