<UserControl x:Class="FamilyClaimRef.App.Views.ProductClaimSubmissionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FamilyClaimRef.App.ViewModels"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.AutomationId="ProductScreen_08">
        <Grid MaxWidth="1520"
              Margin="24,20,24,36"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Breadcrumb, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductPageTitleStyle}" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Subtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top">
                    <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step3}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimReferenceResult}"
                            IsEnabled="{Binding CanNavigateAway}"
                            AutomationProperties.AutomationId="ProductClaimSubmission_GoReference"
                            Style="{StaticResource ProductSecondaryButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step5}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimComplete}"
                            IsEnabled="{Binding CanNavigateAway}"
                            AutomationProperties.AutomationId="ProductClaimSubmission_GoComplete"
                            Style="{StaticResource ProductSecondaryButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button Content="{StaticResource Ui.Product.ClaimSubmission.HistoryAction}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.HistoryView}"
                            IsEnabled="{Binding CanNavigateAway}"
                            AutomationProperties.AutomationId="ProductClaimSubmission_GoHistory"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                </WrapPanel>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource ProductPanelStyle}"
                    Margin="0,18,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="{StaticResource Ui.Product.ClaimSubmission.ClaimCaseLabel}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding AvailableClaimCases}"
                                  DisplayMemberPath="DisplayTitle"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedClaimCaseId, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSwitchSubmission}"
                                  SelectionChanged="ClaimCase_SelectionChanged"
                                  AutomationProperties.AutomationId="ProductClaimSubmission_ClaimCase" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{StaticResource Ui.Product.ClaimSubmission.Guidance}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{StaticResource Ui.Product.ClaimSubmission.UnsavedNavigationGuidance}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ProductPanelStyle}"
                        Margin="0,0,14,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{StaticResource Ui.Product.ClaimSubmission.ListTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,10" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Submissions}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  IsEnabled="{Binding CanSwitchSubmission}"
                                  SelectionMode="Single"
                                  SelectionChanged="SubmissionList_SelectionChanged"
                                  MaxHeight="430"
                                  AutomationProperties.AutomationId="ProductClaimSubmission_List">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="AutomationProperties.Name"
                                            Value="{Binding PolicyDisplayTitle}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{StaticResource Ui.Product.ClaimSubmission.PolicyLabel}"
                                                    Binding="{Binding PolicyDisplayTitle}"
                                                    Width="*" />
                                <DataGridTextColumn Header="{StaticResource Ui.Product.ClaimSubmission.StatusLabel}"
                                                    Binding="{Binding StatusDisplay}"
                                                    Width="105" />
                                <DataGridTextColumn Header="{StaticResource Ui.Product.ClaimSubmission.UpdatedAtLabel}"
                                                    Binding="{Binding UpdatedAtDisplay}"
                                                    Width="125" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1"
                                   Text="{StaticResource Ui.Product.ClaimSubmission.EmptyMessage}"
                                   TextWrapping="Wrap"
                                   Margin="8,12,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource ProductSubtitleStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSubmissionListEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Row="2"
                                Content="{StaticResource Ui.Product.ClaimSubmission.NewAction}"
                                Click="NewButton_Click"
                                IsEnabled="{Binding CanSwitchSubmission}"
                                AutomationProperties.AutomationId="ProductClaimSubmission_New"
                                Style="{StaticResource ProductSecondaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource ProductPanelStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Ui.Product.ClaimSubmission.DetailTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,12" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="{StaticResource Ui.Product.ClaimSubmission.PolicyLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailablePolicies}"
                                          DisplayMemberPath="DisplayText"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedPolicyId, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ProductClaimSubmission_Policy">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{StaticResource Ui.Product.ClaimSubmission.CoverageLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding CoverageDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditDetails}"
                                         AutomationProperties.AutomationId="ProductClaimSubmission_Coverage" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="{StaticResource Ui.Product.ClaimSubmission.SubmittedDateLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}"
                                           Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding SubmittedDate, Mode=TwoWay}"
                                            IsEnabled="{Binding CanEditDetails}"
                                            AutomationProperties.AutomationId="ProductClaimSubmission_Date" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{StaticResource Ui.Product.ClaimSubmission.SubmittedAmountLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding SubmittedAmountText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditDetails}"
                                         TextAlignment="Right"
                                         AutomationProperties.AutomationId="ProductClaimSubmission_Amount" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="{StaticResource Ui.Product.ClaimSubmission.StatusLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableStatusOptions}"
                                          DisplayMemberPath="DisplayText"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedStatus, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEditDetails}"
                                          AutomationProperties.AutomationId="ProductClaimSubmission_Status" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{StaticResource Ui.Product.ClaimSubmission.DocumentLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}"
                                           Margin="0,0,0,4" />
                                <ListBox ItemsSource="{Binding AvailableDocuments}"
                                         IsEnabled="{Binding CanEditDetails}"
                                         MaxHeight="112"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.AutomationId="ProductClaimSubmission_Documents">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Content="{Binding DisplayTitle}"
                                                      ToolTip="{Binding DocumentType}"
                                                      Margin="3" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{StaticResource Ui.Product.ClaimSubmission.MemoLabel}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditDetails}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 MinHeight="68"
                                 AutomationProperties.AutomationId="ProductClaimSubmission_Memo" />
                        <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="{StaticResource Ui.Product.ClaimSubmission.CreateAction}"
                                    Click="CreateButton_Click"
                                    IsEnabled="{Binding CanCreate}"
                                    AutomationProperties.AutomationId="ProductClaimSubmission_Create"
                                    Style="{StaticResource ProductPrimaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="{StaticResource Ui.Product.ClaimSubmission.SaveAction}"
                                    Click="SaveButton_Click"
                                    IsEnabled="{Binding CanSave}"
                                    AutomationProperties.AutomationId="ProductClaimSubmission_Save"
                                    Style="{StaticResource ProductPrimaryButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Style="{StaticResource ProductPanelStyle}"
                    Margin="0,0,0,14">
                <Grid DataContext="{Binding PaymentManagement}"
                      IsEnabled="{Binding DataContext.CanEditPayment, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{StaticResource Ui.Product.ClaimPayment.SectionTitle}"
                               Style="{StaticResource ProductSectionTitleStyle}" />
                    <TextBlock Grid.Row="1"
                               Text="{StaticResource Ui.Product.ClaimPayment.Guidance}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,12" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{StaticResource Ui.Product.ClaimPayment.ListTitle}"
                                       Style="{StaticResource ProductSubtitleStyle}"
                                       Margin="0,0,0,8" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Payments}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="PaymentList_SelectionChanged"
                                      IsEnabled="{Binding CanNavigateAway}"
                                      MaxHeight="250"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      AutomationProperties.AutomationId="ProductClaimPayment_List">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="AutomationProperties.Name"
                                                Value="{Binding StatusDisplay}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{StaticResource Ui.Product.ClaimPayment.StatusLabel}"
                                                        Binding="{Binding StatusDisplay}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="{StaticResource Ui.Product.ClaimPayment.PaidDateLabel}"
                                                        Binding="{Binding PaidDateDisplay}"
                                                        Width="94" />
                                    <DataGridTextColumn Header="{StaticResource Ui.Product.ClaimPayment.PaidAmountLabel}"
                                                        Binding="{Binding PaidAmountDisplay}"
                                                        Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1"
                                       Text="{StaticResource Ui.Product.ClaimPayment.EmptyMessage}"
                                       TextWrapping="Wrap"
                                       Margin="8,12,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource ProductSubtitleStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaymentListEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Row="2"
                                    Content="{StaticResource Ui.Product.ClaimPayment.NewAction}"
                                    Click="NewPaymentButton_Click"
                                    IsEnabled="{Binding CanNavigateAway}"
                                    AutomationProperties.AutomationId="ProductClaimPayment_New"
                                    Style="{StaticResource ProductSecondaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{StaticResource Ui.Product.ClaimPayment.DetailTitle}"
                                       Style="{StaticResource ProductSubtitleStyle}"
                                       Margin="0,0,0,8" />
                            <UniformGrid Grid.Row="1" Columns="3">
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimPayment.StatusLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableStatusOptions}"
                                              DisplayMemberPath="DisplayText"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedStatus, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEditDetails}"
                                              AutomationProperties.AutomationId="ProductClaimPayment_Status" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimPayment.PaidDateLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding PaidDate, Mode=TwoWay}"
                                                IsEnabled="{Binding IsPaidResultEnabled}"
                                                AutomationProperties.AutomationId="ProductClaimPayment_PaidDate" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimPayment.PaidAmountLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding PaidAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsPaidResultEnabled}"
                                             TextAlignment="Right"
                                             AutomationProperties.AutomationId="ProductClaimPayment_PaidAmount" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimPayment.CoverageLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding PaidCoverageDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsPaidResultEnabled}"
                                             AutomationProperties.AutomationId="ProductClaimPayment_Coverage" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimPayment.DenyReasonLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding DenyReason, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsDenyReasonEnabled}"
                                             AutomationProperties.AutomationId="ProductClaimPayment_DenyReason" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimPayment.ReductionReasonLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ReductionReason, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsReductionReasonEnabled}"
                                             AutomationProperties.AutomationId="ProductClaimPayment_ReductionReason" />
                                </StackPanel>
                            </UniformGrid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimPayment.AdditionalDocumentsLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding AdditionalDocumentsMemo, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsAdditionalDocumentsEnabled}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             MinHeight="58"
                                             AutomationProperties.AutomationId="ProductClaimPayment_AdditionalDocuments" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{StaticResource Ui.Product.ClaimPayment.MemoLabel}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditDetails}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             MinHeight="58"
                                             AutomationProperties.AutomationId="ProductClaimPayment_Memo" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="{StaticResource Ui.Product.ClaimPayment.CreateAction}"
                                        Click="CreatePaymentButton_Click"
                                        IsEnabled="{Binding CanCreate}"
                                        AutomationProperties.AutomationId="ProductClaimPayment_Create"
                                        Style="{StaticResource ProductPrimaryButtonStyle}"
                                        Margin="0,0,8,0" />
                                <Button Content="{StaticResource Ui.Product.ClaimPayment.SaveAction}"
                                        Click="SavePaymentButton_Click"
                                        IsEnabled="{Binding CanSave}"
                                        AutomationProperties.AutomationId="ProductClaimPayment_Save"
                                        Style="{StaticResource ProductPrimaryButtonStyle}" />
                            </WrapPanel>
                            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                                <TextBlock Text="{Binding ValidationMessage}"
                                           AutomationProperties.AutomationId="ProductClaimPayment_ValidationMessage"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ConflictMessage}"
                                           AutomationProperties.AutomationId="ProductClaimPayment_ConflictMessage"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LegacyReviewMessage}"
                                           AutomationProperties.AutomationId="ProductClaimPayment_LegacyMessage"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReferenceMessage}"
                                           AutomationProperties.AutomationId="ProductClaimPayment_ReferenceMessage"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding TransitionMessage}"
                                           AutomationProperties.AutomationId="ProductClaimPayment_TransitionMessage"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding OperationMessage}"
                                           AutomationProperties.AutomationId="ProductClaimPayment_OperationMessage"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Style="{StaticResource ProductPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Management.StatusLabel}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ValidationMessage}"
                               AutomationProperties.AutomationId="ProductClaimSubmission_ValidationMessage"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConflictMessage}"
                               AutomationProperties.AutomationId="ProductClaimSubmission_ConflictMessage"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LegacyReviewMessage}"
                               AutomationProperties.AutomationId="ProductClaimSubmission_LegacyMessage"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReferenceMessage}"
                               AutomationProperties.AutomationId="ProductClaimSubmission_ReferenceMessage"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TransitionMessage}"
                               AutomationProperties.AutomationId="ProductClaimSubmission_TransitionMessage"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding OperationMessage}"
                               AutomationProperties.AutomationId="ProductClaimSubmission_OperationMessage"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
