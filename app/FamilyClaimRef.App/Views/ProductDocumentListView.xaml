<UserControl x:Class="FamilyClaimRef.App.Views.ProductDocumentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FamilyClaimRef.App.ViewModels"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="ProductScreen_05">
        <Grid MaxWidth="1420"
              Margin="28,24,28,36"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Breadcrumb, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductPageTitleStyle}" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Subtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="{StaticResource Ui.Product.Wireframe.17_policy_document_register.Title}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.PolicyDocumentRegister}"
                            AutomationProperties.AutomationId="ProductDocumentBox_AddPolicy"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.18_claim_document_register.Title}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimDocumentRegister}"
                            AutomationProperties.AutomationId="ProductDocumentBox_AddClaim"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.OcrAction}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.OcrReview}"
                            AutomationProperties.AutomationId="ProductDocumentBox_Ocr"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="#FBFCFD"
                    BorderBrush="{StaticResource ProductBorderBrush}"
                    BorderThickness="0,0,0,0"
                    Padding="12"
                    Margin="0,0,0,14">
                <TextBlock Text="{StaticResource Ui.Product.Wireframe.DocumentBox.Note}"
                           Style="{StaticResource ProductSubtitleStyle}" />
            </Border>

            <UniformGrid Grid.Row="2"
                         Columns="2"
                         Margin="0,0,0,14">
                <Border Style="{StaticResource ProductPanelStyle}"
                        Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.DocumentBox.ManagedTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.DocumentBox.ManagedTypes}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ProductPanelStyle}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.DocumentBox.ClaimTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.DocumentBox.ClaimTypes}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <ProgressBar Grid.Row="3"
                         Height="4"
                         IsIndeterminate="True"
                         Margin="0,0,0,10">
                <ProgressBar.Style>
                    <Style TargetType="{x:Type ProgressBar}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <Border Grid.Row="4"
                    Style="{StaticResource ProductPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.DocumentBox.ListTitle}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,12" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Items}"
                              MinHeight="260"
                              AutomationProperties.AutomationId="ProductDocumentBox_List">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{StaticResource Ui.Product.Wireframe.DocumentBox.ColumnDocument}"
                                                Binding="{Binding DisplayTitle}"
                                                Width="2*" />
                            <DataGridTextColumn Header="{StaticResource Ui.Product.Wireframe.DocumentBox.ColumnPurpose}"
                                                Binding="{Binding Purpose}"
                                                Width="*" />
                            <DataGridTextColumn Header="{StaticResource Ui.Product.Wireframe.DocumentBox.ColumnType}"
                                                Binding="{Binding DocumentType}"
                                                Width="*" />
                            <DataGridTextColumn Header="{StaticResource Ui.Product.Wireframe.DocumentBox.ColumnTarget}"
                                                Binding="{Binding Target}"
                                                Width="*" />
                            <DataGridTextColumn Header="{StaticResource Ui.Product.Wireframe.DocumentBox.ColumnOcr}"
                                                Binding="{Binding OcrStatus}"
                                                Width="*" />
                            <DataGridTemplateColumn Header="{StaticResource Ui.Product.Wireframe.DocumentBox.ColumnCheck}"
                                                    Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{StaticResource Ui.Product.Wireframe.Common.OcrAction}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{x:Static viewModels:ProductScreenRoutes.OcrReview}"
                                                AutomationProperties.Name="{StaticResource Ui.Product.Wireframe.Common.OcrAction}"
                                                Style="{StaticResource ProductSecondaryButtonStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1"
                               Text="{Binding EmptyMessage}"
                               Margin="8,38,8,0"
                               VerticalAlignment="Top"
                               Panel.ZIndex="1">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource ProductSubtitleStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="1"
                               Text="{Binding LoadFailedMessage}"
                               Foreground="{StaticResource ProductWarningBrush}"
                               Margin="8,38,8,0"
                               VerticalAlignment="Top"
                               Panel.ZIndex="1">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLoadError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
