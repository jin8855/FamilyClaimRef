<UserControl x:Class="FamilyClaimRef.App.Views.ProductDocumentRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:storage="clr-namespace:FamilyClaimRef.App.Models.Storage"
             xmlns:viewModels="clr-namespace:FamilyClaimRef.App.ViewModels"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="ProductDocumentRegistrationScreen">
        <Grid MaxWidth="1420"
              Margin="28,24,28,36"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Breadcrumb, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductPageTitleStyle}" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Subtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.OcrAction}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.OcrReview}"
                            AutomationProperties.AutomationId="ProductRegistration_Ocr"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.11_policy_manage.Title}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.PolicyManage}"
                            AutomationProperties.AutomationId="ProductRegistration_BackPolicy">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="policy">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{StaticResource Ui.Product.Wireframe.07_claim_case.Title}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimCase}"
                            AutomationProperties.AutomationId="ProductRegistration_BackClaim">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="claim">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource ProductPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Registration.SelectedFileTitle}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{StaticResource Ui.Action.SelectFile}"
                                Click="SelectFileButton_Click"
                                AutomationProperties.AutomationId="ProductRegistration_SelectFile">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource ProductPrimaryButtonStyle}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Grid.Column="1"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{StaticResource Ui.Document.SelectedFileLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding SelectedSourceFileDisplayName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="ProductRegistration_SelectedFile" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Registration.SecurityNote}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource ProductPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Registration.TargetTitle}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,10" />

                    <Border Background="{StaticResource ProductAccentSoftBrush}"
                            BorderBrush="{StaticResource ProductBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Registration.TargetSummaryTitle}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TargetKind}" Value="policy">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{StaticResource Ui.Product.Wireframe.Registration.PolicyTargetSummary}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                                <TextBlock Text="{Binding ElementName=PolicyTargetCombo, Path=SelectedItem.DisplayTitle}"
                                           FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TargetKind}" Value="claim">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{StaticResource Ui.Product.Wireframe.Registration.ClaimTargetSummary}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                                <TextBlock Text="{Binding ElementName=ClaimTargetCombo, Path=SelectedItem.DisplayTitle}"
                                           FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="policy">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{StaticResource Ui.Product.DocumentRegistration.PolicyTargetLabel}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   Margin="0,0,0,4" />
                        <ComboBox x:Name="PolicyTargetCombo"
                                  ItemsSource="{Binding AvailablePolicies}"
                                  DisplayMemberPath="DisplayTitle"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedPolicyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.AutomationId="ProductRegistration_PolicyTarget" />
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="claim">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{StaticResource Ui.Product.DocumentRegistration.ClaimTargetLabel}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   Margin="0,10,0,4" />
                        <ComboBox x:Name="ClaimTargetCombo"
                                  ItemsSource="{Binding AvailableClaims}"
                                  DisplayMemberPath="DisplayTitle"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedClaimId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.AutomationId="ProductRegistration_ClaimTarget" />
                    </StackPanel>

                    <TextBlock Text="{Binding TargetSelectionMessage}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Style="{StaticResource ProductPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Registration.MetadataTitle}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{StaticResource Ui.Document.TypeLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}"
                                       Margin="0,0,0,4" />
                            <ComboBox DisplayMemberPath="Label"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding DocumentType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.AutomationId="ProductRegistration_DocumentType">
                                <ComboBox.Style>
                                    <Style TargetType="{x:Type ComboBox}">
                                        <Setter Property="ItemsSource"
                                                Value="{x:Static storage:DocumentTypeSeeds.Policy}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TargetKind}" Value="claim">
                                                <Setter Property="ItemsSource"
                                                        Value="{x:Static storage:DocumentTypeSeeds.Claim}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,12,0">
                            <TextBlock Text="{StaticResource Ui.Document.DisplayTitleLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding DisplayTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="ProductRegistration_DisplayTitle" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{StaticResource Ui.Document.ReferenceDateLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}"
                                       Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding ReferenceDate, Mode=TwoWay}"
                                        AutomationProperties.AutomationId="ProductRegistration_ReferenceDate" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="{StaticResource Ui.Action.RegisterDocument}"
                        Click="RegisterButton_Click"
                        AutomationProperties.AutomationId="ProductRegistration_Register">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}"
                               BasedOn="{StaticResource ProductPrimaryButtonStyle}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border Grid.Column="1"
                        Style="{StaticResource ProductPanelStyle}"
                        Margin="14,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Ui.Status.RegistrationSection}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ValidationMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ProductWarningBrush}"
                                   AutomationProperties.AutomationId="ProductRegistration_Validation" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   AutomationProperties.AutomationId="ProductRegistration_Status" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
