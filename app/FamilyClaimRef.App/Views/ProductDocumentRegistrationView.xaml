<UserControl x:Class="FamilyClaimRef.App.Views.ProductDocumentRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:storage="clr-namespace:FamilyClaimRef.App.Models.Storage"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{StaticResource Ui.Product.DocumentRegistration.Title}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <GroupBox Header="{StaticResource Ui.Document.SourceFileSection}"
                      Margin="0,0,0,12">
                <StackPanel Margin="10">
                    <Button Content="{StaticResource Ui.Action.SelectFile}"
                            Width="120"
                            HorizontalAlignment="Left"
                            Click="SelectFileButton_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{StaticResource Ui.Document.SelectedFileLabel}"
                               FontWeight="SemiBold"
                               Margin="0,10,0,3" />
                    <TextBlock Text="{Binding SelectedSourceFileDisplayName}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{StaticResource Ui.Product.DocumentRegistration.TargetSelectionSection}"
                      Margin="0,0,0,12">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{StaticResource Ui.Target.KindLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8" />
                    <ComboBox Grid.Row="0"
                              Grid.Column="1"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding TargetKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,8">
                        <ComboBoxItem Content="{StaticResource Ui.Product.DocumentRegistration.PolicyTargetLabel}"
                                      Tag="policy" />
                        <ComboBoxItem Content="{StaticResource Ui.Product.DocumentRegistration.ClaimTargetLabel}"
                                      Tag="claim" />
                    </ComboBox>

                    <TextBlock Grid.Row="1"
                               Text="{StaticResource Ui.Product.DocumentRegistration.PolicyTargetLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="policy">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              ItemsSource="{Binding AvailablePolicies}"
                              DisplayMemberPath="DisplayTitle"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedPolicyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,8">
                        <ComboBox.Style>
                            <Style TargetType="{x:Type ComboBox}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="policy">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <TextBlock Grid.Row="2"
                               Text="{StaticResource Ui.Product.DocumentRegistration.ClaimTargetLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="claim">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              ItemsSource="{Binding AvailableClaims}"
                              DisplayMemberPath="DisplayTitle"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedClaimId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,8">
                        <ComboBox.Style>
                            <Style TargetType="{x:Type ComboBox}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="claim">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="{Binding TargetSelectionMessage}"
                               TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{StaticResource Ui.Document.MetadataSection}"
                      Margin="0,0,0,12">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{StaticResource Ui.Document.TypeLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8" />
                    <ComboBox Grid.Row="0"
                              Grid.Column="1"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding DocumentType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,8">
                        <ComboBox.Style>
                            <Style TargetType="{x:Type ComboBox}">
                                <Setter Property="ItemsSource"
                                        Value="{x:Static storage:DocumentTypeSeeds.Policy}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TargetKind}" Value="claim">
                                        <Setter Property="ItemsSource"
                                                Value="{x:Static storage:DocumentTypeSeeds.Claim}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <TextBlock Grid.Row="1"
                               Text="{StaticResource Ui.Document.DisplayTitleLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,8" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding DisplayTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2"
                               Text="{StaticResource Ui.Document.ReferenceDateLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <DatePicker Grid.Row="2"
                                Grid.Column="1"
                                SelectedDate="{Binding ReferenceDate, Mode=TwoWay}" />
                </Grid>
            </GroupBox>

            <Button Content="{StaticResource Ui.Action.RegisterDocument}"
                    Width="120"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,12"
                    Click="RegisterButton_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <GroupBox Header="{StaticResource Ui.Status.RegistrationSection}">
                <StackPanel Margin="10">
                    <TextBlock Text="{StaticResource Ui.Validation.SectionLabel}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ValidationMessage}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,8" />
                    <TextBlock Text="{StaticResource Ui.Status.Label}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
