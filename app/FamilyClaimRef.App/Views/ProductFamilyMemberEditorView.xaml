<UserControl x:Class="FamilyClaimRef.App.Views.ProductFamilyMemberEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="ProductScreen_13">
        <Grid MaxWidth="1120"
              Margin="28,24,28,36"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{Binding DataContext.CurrentScreen.Breadcrumb, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Style="{StaticResource ProductSubtitleStyle}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding DataContext.CurrentScreen.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Style="{StaticResource ProductPageTitleStyle}" />
                <TextBlock Text="{Binding DataContext.CurrentScreen.Subtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           Style="{StaticResource ProductSubtitleStyle}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource ProductPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,16,16">
                        <TextBlock Text="{StaticResource Ui.Product.FamilyMember.DisplayNameLabel}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   Margin="0,0,0,5" />
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProductFamily_DisplayName" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,0,16">
                        <TextBlock Text="{StaticResource Ui.Product.FamilyMember.RelationLabel}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding RelationOptions}"
                                  SelectedItem="{Binding SelectedRelation, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="ProductFamily_Relation" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,0,16,0">
                        <TextBlock Text="{StaticResource Ui.Product.FamilyMember.MemoLabel}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   Margin="0,0,0,5" />
                        <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="100"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="ProductFamily_Memo" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="1">
                        <TextBlock Text="{StaticResource Ui.Product.FamilyMember.ActiveStateLabel}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   Margin="0,0,0,5" />
                        <TextBlock Text="{StaticResource Ui.Product.Wireframe.Common.ActiveValue}"
                                   FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="ProductFamily_ActiveState" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource ProductPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ManagementMessage}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ProductFamily_EditorStatus" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Content="{StaticResource Ui.Product.Wireframe.Common.SaveAction}"
                                Click="SaveButton_Click"
                                IsEnabled="{Binding CanSave}"
                                AutomationProperties.AutomationId="ProductFamily_Save"
                                Style="{StaticResource ProductPrimaryButtonStyle}" />
                        <Button Content="{StaticResource Ui.Product.Wireframe.Common.DeleteAction}"
                                IsEnabled="{Binding CanDelete}"
                                AutomationProperties.AutomationId="ProductFamily_Delete"
                                Style="{StaticResource ProductSecondaryButtonStyle}" />
                        <Button Content="{StaticResource Ui.Product.Wireframe.Common.DisableAction}"
                                Click="DeactivateButton_Click"
                                IsEnabled="{Binding CanDeactivate}"
                                AutomationProperties.AutomationId="ProductFamily_Deactivate"
                                Style="{StaticResource ProductSecondaryButtonStyle}" />
                        <Button Content="{StaticResource Ui.Product.Wireframe.Common.CloseAction}"
                                Click="CloseButton_Click"
                                IsEnabled="{Binding CanUseRowActions}"
                                AutomationProperties.AutomationId="ProductFamily_Close"
                                Style="{StaticResource ProductSecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="#FBFCFD"
                    Padding="12">
                <TextBlock Text="{StaticResource Ui.Product.Wireframe.13_family_register.Secondary}"
                           Style="{StaticResource ProductSubtitleStyle}"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
