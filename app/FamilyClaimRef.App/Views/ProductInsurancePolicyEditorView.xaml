<UserControl x:Class="FamilyClaimRef.App.Views.ProductInsurancePolicyEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="UserControl_SizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.AutomationId="ProductScreen_12">
        <Grid Margin="24,16,24,24"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderArea"
                  Margin="0,0,0,12"
                  AutomationProperties.AutomationId="ProductInsurance_CommandBar">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderTitleColumn" Width="*" />
                    <ColumnDefinition x:Name="HeaderCommandColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="HeaderTitleArea" Margin="0,0,20,0">
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Breadcrumb, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,0,0,5" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductPageTitleStyle}" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Subtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding InsurancePolicyMessage}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"
                               AutomationProperties.AutomationId="ProductInsurance_Status" />
                </StackPanel>
                <WrapPanel x:Name="HeaderCommands"
                           Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top">
                    <Button Content="{StaticResource Ui.Product.InsurancePolicy.TemporarySaveAction}"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="ProductInsurance_TemporarySave"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.SaveAction}"
                            Click="SaveButton_Click"
                            IsEnabled="{Binding CanSaveInsurancePolicy}"
                            AutomationProperties.AutomationId="ProductInsurance_Save"
                            Style="{StaticResource ProductPrimaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.HoldAction}"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="ProductInsurance_Hold"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.DeleteAction}"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="ProductInsurance_Delete"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.DisableAction}"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="ProductInsurance_Disable"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.Common.CloseAction}"
                            Click="CloseButton_Click"
                            AutomationProperties.AutomationId="ProductInsurance_Close"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                </WrapPanel>
            </Grid>

            <Grid x:Name="UpperWorkArea"
                  Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SummaryColumn" Width="*" />
                    <ColumnDefinition x:Name="DocumentColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="InsuranceSummaryPanel"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,7,0"
                        Style="{StaticResource ProductPanelStyle}"
                        AutomationProperties.AutomationId="ProductInsurance_SummaryPanel">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.SummarySectionTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.BasicInformationSection}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,10" />
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.FamilyLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding AvailablePolicyFamilyMembers}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedInsuranceFamilyMemberId, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ProductInsurance_Family" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{StaticResource Ui.Product.PolicyContracts.DisplayTitleLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding InsuranceDisplayTitle, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ProductInsurance_DisplayTitle" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.InsurerLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding InsuranceInsurerName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ProductInsurance_Insurer" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.EnrollmentDateLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                                <DatePicker SelectedDate="{Binding InsuranceEnrollmentDate, Mode=TwoWay}"
                                            AutomationProperties.AutomationId="ProductInsurance_EnrollmentDate" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.CoveragePaymentSection}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,10" />
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.CoveragePeriodLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding InsuranceCoveragePeriod, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ProductInsurance_CoveragePeriod" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.PremiumPaymentPeriodLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding InsurancePremiumPaymentPeriod, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ProductInsurance_PremiumPaymentPeriod" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.TotalPlannedPremiumAmountLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding InsuranceTotalPlannedPremiumAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             TextAlignment="Right"
                                             PreviewTextInput="PremiumAmount_PreviewTextInput"
                                             TextChanged="PremiumAmount_TextChanged"
                                             DataObject.Pasting="PremiumAmount_Pasting"
                                             AutomationProperties.AutomationId="ProductInsurance_TotalPlannedPremiumAmount" />
                                    <TextBlock Grid.Column="1"
                                               Text="{StaticResource Ui.Product.InsurancePolicy.CurrencySuffix}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.ClassificationSection}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,10" />
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.ContractStatusLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding InsuranceContractStatusOptions}"
                                          SelectedItem="{Binding InsuranceContractStatus, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ProductInsurance_ContractStatus" />
                                <TextBlock Text="{Binding InsuranceContractStatusGuidance}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.RenewalTypeLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding InsuranceRenewalTypeOptions}"
                                          SelectedItem="{Binding InsuranceRenewalType, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ProductInsurance_RenewalType" />
                                <TextBlock Text="{Binding InsuranceRenewalTypeGuidance}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.RefundTypeLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding InsuranceRefundTypeOptions}"
                                          SelectedItem="{Binding InsuranceRefundType, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ProductInsurance_RefundType" />
                                <TextBlock Text="{Binding InsuranceRefundTypeGuidance}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.BusinessTypeLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding InsuranceBusinessTypeOptions}"
                                          SelectedItem="{Binding InsuranceBusinessType, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ProductInsurance_BusinessType" />
                                <TextBlock Text="{Binding InsuranceBusinessTypeGuidance}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.ProductCategoryLabel}"
                                           Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding InsuranceProductCategoryOptions}"
                                          SelectedItem="{Binding InsuranceProductCategory, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ProductInsurance_ProductCategory" />
                                <TextBlock Text="{Binding InsuranceProductCategoryGuidance}"
                                           Style="{StaticResource ProductSubtitleStyle}" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.RegistrationInformationSection}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,10" />
                        <StackPanel>
                            <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.RegistrationSourceLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding InsuranceRegistrationSource, Mode=OneWay}"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     AutomationProperties.AutomationId="ProductInsurance_RegistrationSource" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="LinkedDocumentsPanel"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="7,0,0,0"
                        Style="{StaticResource ProductPanelStyle}"
                        AutomationProperties.AutomationId="ProductInsurance_LinkedDocumentsPanel">
                    <StackPanel>
                        <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.LinkedDocumentsSectionTitle}"
                                   Style="{StaticResource ProductSectionTitleStyle}"
                                   Margin="0,0,0,10" />
                        <Border BorderBrush="{StaticResource ProductMutedTextBrush}"
                                BorderThickness="4,0,0,0"
                                Background="#FBFCFD"
                                Padding="10"
                                Margin="0,0,0,10">
                            <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.LinkedDocumentsGuidance}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                        </Border>

                        <Grid AutomationProperties.AutomationId="ProductInsurance_LinkedDocumentTable">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#F8FAFC"
                                    BorderBrush="#E4E8EC" BorderThickness="0,0,0,1" />
                            <TextBlock Grid.Row="0" Grid.Column="0" Padding="10,8"
                                       FontWeight="SemiBold"
                                       Text="{StaticResource Ui.Product.InsurancePolicy.DocumentTypeHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Padding="10,8"
                                       FontWeight="SemiBold"
                                       Text="{StaticResource Ui.Product.InsurancePolicy.DocumentStatusHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Padding="10,8"
                                       FontWeight="SemiBold"
                                       Text="{StaticResource Ui.Product.InsurancePolicy.DocumentNextActionHeader}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Padding="10,8"
                                       Text="{StaticResource Ui.Product.InsurancePolicy.DocumentCaptureType}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Padding="10,8"
                                       Text="{StaticResource Ui.Product.InsurancePolicy.DocumentPolicyType}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Padding="10,8"
                                       Text="{StaticResource Ui.Product.InsurancePolicy.DocumentTermsType}" />

                            <TextBlock Grid.Row="1" Grid.Column="1" Padding="10,8"
                                       Text="{Binding InsuranceCaptureDocumentStatus}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Padding="10,8"
                                       Text="{Binding InsurancePolicyDocumentStatus}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Padding="10,8"
                                       Text="{Binding InsuranceTermsDocumentStatus}" />

                            <WrapPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                                <Button Tag="capture"
                                        Click="DocumentPrimaryButton_Click"
                                        IsEnabled="{Binding IsInsurancePolicyEditMode}"
                                        AutomationProperties.AutomationId="ProductInsurance_CaptureDocumentPrimary"
                                        Margin="8,4,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                            <Setter Property="Content" Value="{StaticResource Ui.Product.InsurancePolicy.DocumentRegisterAction}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInsuranceCaptureDocument}" Value="True">
                                                    <Setter Property="Content" Value="{StaticResource Ui.Product.InsurancePolicy.DocumentOpenAction}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Tag="capture" Content="{StaticResource Ui.Product.InsurancePolicy.DocumentReplaceAction}"
                                        Click="ReplaceDocumentButton_Click"
                                        IsEnabled="{Binding IsInsurancePolicyEditMode}"
                                        AutomationProperties.AutomationId="ProductInsurance_CaptureDocumentReplace"
                                        Margin="4,4,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInsuranceCaptureDocument}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Tag="capture" Content="{StaticResource Ui.Product.InsurancePolicy.DocumentUnlinkAction}"
                                        Click="UnlinkDocumentButton_Click"
                                        IsEnabled="{Binding IsInsurancePolicyEditMode}"
                                        AutomationProperties.AutomationId="ProductInsurance_CaptureDocumentUnlink"
                                        Margin="4,4,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInsuranceCaptureDocument}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>
                            <WrapPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
                                <Button Tag="policy"
                                        Click="DocumentPrimaryButton_Click"
                                        IsEnabled="{Binding IsInsurancePolicyEditMode}"
                                        AutomationProperties.AutomationId="ProductInsurance_PolicyDocumentPrimary"
                                        Margin="8,4,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                            <Setter Property="Content" Value="{StaticResource Ui.Product.InsurancePolicy.DocumentRegisterAction}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInsurancePolicyDocument}" Value="True">
                                                    <Setter Property="Content" Value="{StaticResource Ui.Product.InsurancePolicy.DocumentOpenAction}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Tag="policy" Content="{StaticResource Ui.Product.InsurancePolicy.DocumentReplaceAction}"
                                        Click="ReplaceDocumentButton_Click"
                                        IsEnabled="{Binding IsInsurancePolicyEditMode}"
                                        AutomationProperties.AutomationId="ProductInsurance_PolicyDocumentReplace"
                                        Margin="4,4,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInsurancePolicyDocument}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Tag="policy" Content="{StaticResource Ui.Product.InsurancePolicy.DocumentUnlinkAction}"
                                        Click="UnlinkDocumentButton_Click"
                                        IsEnabled="{Binding IsInsurancePolicyEditMode}"
                                        AutomationProperties.AutomationId="ProductInsurance_PolicyDocumentUnlink"
                                        Margin="4,4,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInsurancePolicyDocument}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>
                            <WrapPanel Grid.Row="3" Grid.Column="2" VerticalAlignment="Center">
                                <Button Tag="terms"
                                        Click="DocumentPrimaryButton_Click"
                                        IsEnabled="{Binding IsInsurancePolicyEditMode}"
                                        AutomationProperties.AutomationId="ProductInsurance_TermsDocumentPrimary"
                                        Margin="8,4,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                            <Setter Property="Content" Value="{StaticResource Ui.Product.InsurancePolicy.DocumentRegisterAction}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInsuranceTermsDocument}" Value="True">
                                                    <Setter Property="Content" Value="{StaticResource Ui.Product.InsurancePolicy.DocumentOpenAction}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Tag="terms" Content="{StaticResource Ui.Product.InsurancePolicy.DocumentReplaceAction}"
                                        Click="ReplaceDocumentButton_Click"
                                        IsEnabled="{Binding IsInsurancePolicyEditMode}"
                                        AutomationProperties.AutomationId="ProductInsurance_TermsDocumentReplace"
                                        Margin="4,4,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInsuranceTermsDocument}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Tag="terms" Content="{StaticResource Ui.Product.InsurancePolicy.DocumentUnlinkAction}"
                                        Click="UnlinkDocumentButton_Click"
                                        IsEnabled="{Binding IsInsurancePolicyEditMode}"
                                        AutomationProperties.AutomationId="ProductInsurance_TermsDocumentUnlink"
                                        Margin="4,4,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInsuranceTermsDocument}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>

                            <Border Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Bottom"
                                    BorderBrush="#E4E8EC" BorderThickness="0,0,0,1" />
                            <Border Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Bottom"
                                    BorderBrush="#E4E8EC" BorderThickness="0,0,0,1" />
                            <Border Grid.Row="3" Grid.ColumnSpan="3" VerticalAlignment="Bottom"
                                    BorderBrush="#E4E8EC" BorderThickness="0,0,0,1" />
                        </Grid>

                        <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.DocumentStatusGuidance}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   Margin="0,8,0,0" />

                        <Expander IsExpanded="False"
                                  Margin="0,8,0,0"
                                  Header="{Binding InsurancePolicyDocumentHistoryTitle}"
                                  AutomationProperties.AutomationId="ProductInsurance_DocumentHistoryExpander">
                            <Expander.Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasInsurancePolicyDocumentHistory}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Style>
                            <ListView ItemsSource="{Binding InsurancePolicyDocumentHistory}"
                                      MaxHeight="220"
                                      Margin="0,8,0,0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      AutomationProperties.AutomationId="ProductInsurance_DocumentHistoryList">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="115"
                                                        Header="{StaticResource Ui.Product.InsurancePolicy.DocumentTypeHeader}"
                                                        DisplayMemberBinding="{Binding DocumentTypeDisplayName}" />
                                        <GridViewColumn Width="135"
                                                        Header="{StaticResource Ui.Product.InsurancePolicy.DocumentHistoryTitleHeader}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayTitle}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="125"
                                                        Header="{StaticResource Ui.Product.InsurancePolicy.DocumentHistoryRegisteredAtHeader}"
                                                        DisplayMemberBinding="{Binding RegisteredAt}" />
                                        <GridViewColumn Width="55"
                                                        Header="{StaticResource Ui.Product.InsurancePolicy.DocumentStatusHeader}"
                                                        DisplayMemberBinding="{Binding Status}" />
                                        <GridViewColumn Width="100"
                                                        Header="{StaticResource Ui.Product.InsurancePolicy.DocumentNextActionHeader}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{StaticResource Ui.Product.InsurancePolicy.DocumentOpenAction}"
                                                            Click="HistoryDocumentOpenButton_Click"
                                                            Style="{StaticResource ProductSecondaryButtonStyle}"
                                                            AutomationProperties.AutomationId="ProductInsurance_DocumentHistoryOpen"
                                                            Margin="2" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource ProductPanelStyle}"
                    AutomationProperties.AutomationId="ProductInsurance_CoverageCandidatesPanel">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.CoverageCandidatesSectionTitle}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,10" />
                    <Border BorderBrush="{StaticResource ProductMutedTextBrush}"
                            BorderThickness="4,0,0,0"
                            Background="#FBFCFD"
                            Padding="10"
                            Margin="0,0,0,10">
                        <TextBlock Text="{StaticResource Ui.Product.InsurancePolicy.CoverageCandidatesGuidance}"
                                   Style="{StaticResource ProductSubtitleStyle}" />
                    </Border>
                    <Grid AutomationProperties.AutomationId="ProductInsurance_CoverageCandidateTable">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.ColumnSpan="6" Background="#F8FAFC"
                                BorderBrush="#E4E8EC" BorderThickness="0,0,0,1" />
                        <TextBlock Grid.Row="0" Grid.Column="0" Padding="10,8" FontWeight="SemiBold"
                                   Text="{StaticResource Ui.Product.InsurancePolicy.CoverageCandidateHeader}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Padding="10,8" FontWeight="SemiBold"
                                   Text="{StaticResource Ui.Product.InsurancePolicy.CareTypeCandidateHeader}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Padding="10,8" FontWeight="SemiBold"
