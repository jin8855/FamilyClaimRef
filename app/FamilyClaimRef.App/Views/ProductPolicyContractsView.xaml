<UserControl x:Class="FamilyClaimRef.App.Views.ProductPolicyContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{StaticResource Ui.Product.PolicyContracts.Title}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16" />

            <GroupBox Header="{StaticResource Ui.Product.PolicyContracts.CreationSection}"
                      Margin="0,0,0,16">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{StaticResource Ui.Product.PolicyContracts.DisplayTitleLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding NewPolicyDisplayTitle, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="240"
                             Margin="0,0,12,0" />
                    <Button Grid.Column="2"
                            Content="{StaticResource Ui.Product.PolicyContracts.CreateAction}"
                            IsEnabled="{Binding CanCreatePolicy}"
                            Click="CreateButton_Click"
                            Padding="14,6" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{StaticResource Ui.Product.PolicyContracts.ActiveListLabel}"
                      Margin="0,0,0,16">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox ItemsSource="{Binding AvailablePolicies}"
                             DisplayMemberPath="DisplayTitle"
                             SelectedValuePath="Id"
                             SelectedValue="{Binding SelectedPolicyId, Mode=TwoWay}"
                             MinHeight="120">
                        <ListBox.Style>
                            <Style TargetType="{x:Type ListBox}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAvailablePolicies}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>

                    <TextBlock Text="{StaticResource Ui.Product.PolicyContracts.EmptyMessage}"
                               VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAvailablePolicies}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Row="1"
                            Content="{StaticResource Ui.Product.PolicyContracts.DisableAction}"
                            IsEnabled="{Binding CanDisablePolicy}"
                            Click="DisableButton_Click"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"
                            Padding="14,6" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{StaticResource Ui.Product.Management.StatusLabel}">
                <TextBlock Text="{Binding ManagementMessage}"
                           Margin="12"
                           TextWrapping="Wrap" />
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
