<UserControl x:Class="FamilyClaimRef.App.Views.ProductPolicyContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FamilyClaimRef.App.ViewModels"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="ProductScreen_11">
        <Grid MaxWidth="1420"
              Margin="28,24,28,36"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Breadcrumb, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductPageTitleStyle}" />
                    <TextBlock Text="{Binding DataContext.CurrentScreen.Subtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="{StaticResource Ui.Product.Wireframe.12_policy_register.Title}"
                            Click="RegisterButton_Click"
                            AutomationProperties.AutomationId="ProductPolicy_Register"
                            Style="{StaticResource ProductPrimaryButtonStyle}" />
                    <Button Content="{StaticResource Ui.Product.Wireframe.15_manage_home.Title}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{x:Static viewModels:ProductScreenRoutes.ManageHome}"
                            AutomationProperties.AutomationId="ProductPolicy_ManageHome"
                            Style="{StaticResource ProductSecondaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource ProductPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{StaticResource Ui.Product.PolicyContracts.ActiveListLabel}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,12" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AvailableInsurancePolicies}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedPolicyId, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MinHeight="260"
                              AutomationProperties.AutomationId="ProductPolicy_List">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{StaticResource Ui.Product.PolicyContracts.DisplayTitleLabel}"
                                                Binding="{Binding DisplayTitle}"
                                                Width="1.6*" />
                            <DataGridTextColumn Header="{StaticResource Ui.Product.InsurancePolicy.FamilyLabel}"
                                                Binding="{Binding FamilyDisplayName}"
                                                Width="*" />
                            <DataGridTextColumn Header="{StaticResource Ui.Product.InsurancePolicy.InsurerLabel}"
                                                Binding="{Binding InsurerName}"
                                                Width="*" />
                            <DataGridTextColumn Header="{StaticResource Ui.Product.InsurancePolicy.ProductCategoryLabel}"
                                                Binding="{Binding ProductCategory}"
                                                Width="*" />
                            <DataGridTextColumn Header="{StaticResource Ui.Product.InsurancePolicy.ContractStatusLabel}"
                                                Binding="{Binding ContractStatus}"
                                                Width="*" />
                            <DataGridTextColumn Header="{StaticResource Ui.Product.InsurancePolicy.EnrollmentDateLabel}"
                                                Binding="{Binding EnrollmentDate}"
                                                Width="0.9*" />
                            <DataGridTextColumn Header="{StaticResource Ui.Product.InsurancePolicy.TotalPlannedPremiumAmountLabel}"
                                                Binding="{Binding TotalPlannedPremiumAmount}"
                                                Width="*" />
                            <DataGridTemplateColumn Header="{StaticResource Ui.Product.Wireframe.Policy.ColumnActions}"
                                                    Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{StaticResource Ui.Product.Wireframe.Common.EditAction}"
                                                    Click="EditPolicyButton_Click"
                                                    AutomationProperties.Name="{StaticResource Ui.Product.Wireframe.Common.EditAction}"
                                                    Style="{StaticResource ProductSecondaryButtonStyle}" />
                                            <Button Content="{StaticResource Ui.Product.Wireframe.Common.AddDocumentAction}"
                                                    Click="AddPolicyDocumentButton_Click"
                                                    AutomationProperties.Name="{StaticResource Ui.Product.Wireframe.Common.AddDocumentAction}"
                                                    Style="{StaticResource ProductSecondaryButtonStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1"
                               Text="{StaticResource Ui.Product.PolicyContracts.EmptyMessage}"
                               Margin="8,38,8,0"
                               VerticalAlignment="Top"
                               Panel.ZIndex="1">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource ProductSubtitleStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAvailableInsurancePolicies}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Row="2"
                            Content="{StaticResource Ui.Product.PolicyContracts.DisableAction}"
                            IsEnabled="{Binding CanDisablePolicy}"
                            Click="DisableButton_Click"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="ProductPolicy_Disable"
                            Style="{StaticResource ProductSecondaryButtonStyle}"
                            Margin="0,12,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource ProductPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Management.StatusLabel}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding InsurancePolicyMessage}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ProductPolicy_Status" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
