<UserControl x:Class="FamilyClaimRef.App.Views.ProductWireframeScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FamilyClaimRef.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.AutomationId="{Binding AutomationId}">
        <Grid MaxWidth="1520"
              Margin="28,24,28,36"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{Binding Breadcrumb}"
                           Style="{StaticResource ProductSubtitleStyle}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource ProductPageTitleStyle}" />
                <TextBlock Text="{Binding Subtitle}"
                           Style="{StaticResource ProductSubtitleStyle}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <UniformGrid Grid.Row="1"
                         Columns="5"
                         Margin="0,0,0,14">
                <UniformGrid.Style>
                    <Style TargetType="{x:Type UniformGrid}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowClaimFlow}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step1}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimCase}"
                        AutomationProperties.AutomationId="ProductClaimFlow_Step1">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ClaimStepNumber}" Value="1">
                                    <Setter Property="Background" Value="{StaticResource ProductAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource ProductAccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step2}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.OcrReview}"
                        AutomationProperties.AutomationId="ProductClaimFlow_Step2">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ClaimStepNumber}" Value="2">
                                    <Setter Property="Background" Value="{StaticResource ProductAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource ProductAccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step3}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimReferenceResult}"
                        AutomationProperties.AutomationId="ProductClaimFlow_Step3">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ClaimStepNumber}" Value="3">
                                    <Setter Property="Background" Value="{StaticResource ProductAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource ProductAccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step4}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimSubmission}"
                        AutomationProperties.AutomationId="ProductClaimFlow_Step4">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ClaimStepNumber}" Value="4">
                                    <Setter Property="Background" Value="{StaticResource ProductAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource ProductAccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{StaticResource Ui.Product.Wireframe.Claim.Step5}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{x:Static viewModels:ProductScreenRoutes.ClaimComplete}"
                        AutomationProperties.AutomationId="ProductClaimFlow_Step5">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ProductSecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ClaimStepNumber}" Value="5">
                                    <Setter Property="Background" Value="{StaticResource ProductAccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource ProductAccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>

            <Border Grid.Row="2"
                    AutomationProperties.AutomationId="ProductClaimFlow_Context">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource ProductPanelStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowClaimFlow}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextTitle}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,10" />
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextPolicyLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding DataContext.ClaimContextPolicyDisplayTitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextClaimLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding DataContext.ClaimContextClaimDisplayTitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextInputLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding DataContext.ClaimContextInputState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{StaticResource Ui.Product.Wireframe.Claim.ContextConfirmationLabel}"
                                       Style="{StaticResource ProductSubtitleStyle}" />
                            <TextBlock Text="{Binding DataContext.ClaimContextConfirmationState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <ItemsControl Grid.Row="3" ItemsSource="{Binding Actions}">
                <ItemsControl.Style>
                    <Style TargetType="{x:Type ItemsControl}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsManagementHub}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding RouteId}"
                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                Style="{StaticResource ProductCardButtonStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="4" ItemsSource="{Binding Groups}">
                <ItemsControl.Style>
                    <Style TargetType="{x:Type ItemsControl}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowStandardGroups}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GroupColumnCount}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProductPanelStyle}"
                                Margin="0,0,14,14"
                                MinHeight="190">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource ProductSectionTitleStyle}"
                                           Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding FieldLabels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{StaticResource Ui.Product.Wireframe.Common.EmptyValue}"
                                                           Style="{StaticResource ProductSubtitleStyle}"
                                                           Margin="12,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border BorderBrush="{StaticResource ProductBorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Margin="0,5,0,0" Padding="0,9,0,0">
                                    <TextBlock Text="{Binding Body}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               FontSize="13" LineHeight="20" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="5" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource ProductPanelStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFields}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Common.FieldsSectionTitle}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding FieldColumnCount}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="{Binding Label}"
                                               Style="{StaticResource ProductSubtitleStyle}"
                                               Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding Label}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Common.PresentationOnlyMessage}"
                               Style="{StaticResource ProductSubtitleStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource ProductPanelStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTable}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding TableTitle}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,12" />
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource ProductBorderBrush}"
                            BorderThickness="1" Padding="10,8">
                        <ItemsControl ItemsSource="{Binding TableColumns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding TableColumnCount}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontWeight="SemiBold"
                                               Foreground="{StaticResource ProductTextBrush}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border BorderBrush="{StaticResource ProductBorderBrush}"
                            BorderThickness="1,0,1,1" Padding="16,26">
                        <TextBlock Text="{Binding EmptyMessage}"
                                   Style="{StaticResource ProductSubtitleStyle}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="7" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource ProductPanelStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCommands}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Commands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding RouteId}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        Style="{StaticResource ProductSecondaryButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Common.DisabledActionMessage}"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ProductSubtitleStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDeferredCommands}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Row="8">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource ProductPanelStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsManagementHub}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{StaticResource Ui.Product.Wireframe.Common.NextActionsTitle}"
                               Style="{StaticResource ProductSectionTitleStyle}"
                               Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding RouteId}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        Style="{StaticResource ProductSecondaryButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
